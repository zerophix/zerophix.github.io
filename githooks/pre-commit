#!/bin/sh
# ═══════════════════════════════════════════
# 提交时自动挂载：pages/<领域>/*.html → <领域>/
#   1. Eleventy 构建（校验失败中止提交，不要用 --no-verify 绕过）
#   2. 生成 mounted.js（首页领域墙/页面列表）与 sitemap.xml
#   3. 暂存各领域输出目录（含附属 css/js/图片）
#   4. 下架孤儿：源目录已删的输出，按构建记录移除并暂存删除
#   5. 资源指纹重写时暂存 index.html（只暂存指纹产物，不卷入其他未提交改动）
# ═══════════════════════════════════════════
set -e
cd "$(git rev-parse --show-toplevel)"

if [ ! -x node_modules/.bin/eleventy ]; then
  echo "[pre-commit] 首次运行，安装依赖..."
  npm install --no-audit --no-fund
fi

echo "[pre-commit] Eleventy 挂载构建..."
node_modules/.bin/eleventy

git add mounted.js sitemap.xml

# 各领域输出目录整体暂存（跳过 _ 开头的源目录）
mounted=0
for d in pages/*/; do
  if [ ! -d "$d" ]; then continue; fi
  name=$(basename "$d")
  case "$name" in _*) continue ;; esac
  if [ -d "$name" ]; then
    git add "$name"
    mounted=$((mounted+1))
  fi
done

# 孤儿下架：eleventy.before 记录的删除（源目录已不存在的输出）
if [ -f .cache/removed-outputs ]; then
  while IFS= read -r d; do
    if [ -n "$d" ] && git ls-files -- "$d" | grep -q .; then
      echo "[pre-commit] 下架孤儿领域 ./$d/"
      git add -A -- "$d"
    fi
  done < .cache/removed-outputs
  rm -f .cache/removed-outputs
fi

# 资源指纹：index.html 引用被重写时暂存它。
# 只暂存 index.html —— 指纹只改写 index.html 的引用，其他文件若也有
# 未提交改动属于进行中的开发工作，必须留在工作区（自动挂载的安全边界）。
if ! git diff --quiet -- index.html 2>/dev/null; then
  git add index.html
  echo "[pre-commit] 资源指纹已更新（?v= 内容哈希）"
fi

echo "[pre-commit] 挂载完成：$mounted 个领域已同步"
